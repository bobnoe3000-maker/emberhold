{
  // Type-checking only (no emit): plain JS + JSDoc, opt-in per file with `// @ts-check`
  // (docs/architecture.md A1). `npm run typecheck`.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["src/**/*.js", "src/types.d.ts"],
  "exclude": ["src/vendor/**"]
}
