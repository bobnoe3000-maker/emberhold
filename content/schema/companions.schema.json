{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The Lantern Guild's sellswords for the player's eyes: rank names and lines, perk family labels, perk names and lines (ids are the sim's, src/sim/companions.js).",
  "type": "object",
  "required": [
    "ranks",
    "families",
    "perks",
    "terms"
  ],
  "additionalProperties": false,
  "properties": {
    "$comment": {
      "type": "string"
    },
    "ranks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "line"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "line": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "families": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20
      }
    },
    "perks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "terms": {
      "type": "object",
      "required": [
        "title",
        "intro",
        "sections",
        "families",
        "found"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "intro": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "head",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "head": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            }
          }
        },
        "families": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "found": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  }
}
