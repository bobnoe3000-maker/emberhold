{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A Lantern Guild board template's words (quest-lore-system §4.2). The shape (what it counts, what it pays) is the sim's: src/sim/board.js BOARD; a test keeps the two in step. Slots take only a number ({n}) or a word from this file ({floor} → ordinals), so every line stays grammatical.",
  "type": "object",
  "required": ["id", "titles", "hooks", "brief", "label", "journal", "ready", "done"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z]+$" },
    "titles": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 32 } },
    "hooks": {
      "type": "array", "minItems": 6,
      "items": { "type": "object", "required": ["by", "text"], "additionalProperties": false,
        "properties": { "by": { "type": "string", "minLength": 1, "maxLength": 32 }, "text": { "type": "string", "minLength": 1, "maxLength": 200 } } }
    },
    "brief": { "type": "object", "required": ["one", "many"], "additionalProperties": false,
      "properties": { "one": { "type": "string", "minLength": 1, "maxLength": 64 }, "many": { "type": "string", "minLength": 1, "maxLength": 64 } } },
    "label": { "type": "string", "minLength": 1, "maxLength": 40 },
    "journal": { "type": "string", "minLength": 1, "maxLength": 160 },
    "ready": { "type": "string", "minLength": 1, "maxLength": 120 },
    "done": { "type": "string", "minLength": 1, "maxLength": 120 },
    "ordinals": { "type": "array", "minItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 12 } }
  }
}
