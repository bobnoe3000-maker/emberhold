{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Where the main story stands (content/story.json; src/ui/storystatus.js)",
  "type": "object",
  "required": ["next", "level", "end", "leadsTitle", "leads"],
  "properties": {
    "$comment": { "type": "string" },
    "next": { "type": "string", "maxLength": 120 },
    "level": { "type": "string", "maxLength": 120 },
    "end": { "type": "object", "additionalProperties": { "type": "object", "required": ["title", "text"], "properties": { "title": { "type": "string" }, "text": { "type": "string", "maxLength": 320 } }, "additionalProperties": false } },
    "leadsTitle": { "type": "object", "required": ["vale", "fens"], "additionalProperties": { "type": "string" } },
    "leads": {
      "type": "object",
      "required": ["brannoc", "standard", "warren", "chronicle", "milestone", "trial", "board"],
      "additionalProperties": { "type": "string", "maxLength": 200 }
    }
  },
  "additionalProperties": false
}
