{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A quest (quest-lore-system \u00a74.1): its words, and the shape the sim counts and pays. The sim keeps its own table of the shape (src/sim/quests.js QUESTS); a test keeps the two in step.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "title",
    "giver",
    "region",
    "level",
    "summary",
    "steps",
    "ready",
    "done",
    "rewards",
    "dialogue"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "kind": {
      "enum": [
        "chapter",
        "companion",
        "trial",
        "board",
        "errand",
        "bounty"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "giver": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "region": {
      "enum": [
        "vale",
        "fens",
        "reach",
        "heights"
      ]
    },
    "level": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "journal",
          "objectives"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "journal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "objectives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "type",
                    "site",
                    "count",
                    "label"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "waves"
                    },
                    "site": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 48
                    },
                    "hall": {
                      "type": "boolean",
                      "description": "only in a floor's stairs-down hall"
                    },
                    "floor": {
                      "type": "integer",
                      "minimum": 1,
                      "description": "on this floor or deeper"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "site",
                    "count",
                    "label"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "loot"
                    },
                    "site": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 48
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "site",
                    "count",
                    "label"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "elites"
                    },
                    "site": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 48
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "site",
                    "count",
                    "label"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "fragment"
                    },
                    "site": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 48
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "site",
                    "count",
                    "label",
                    "boss"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "boss"
                    },
                    "site": {
                      "type": "string"
                    },
                    "boss": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 48
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "site",
                    "count",
                    "label"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "reach"
                    },
                    "site": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1,
                      "description": "the floor to reach (1 = the first)"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 48
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "ready": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "done": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "rewards": {
      "type": "object",
      "required": [
        "xp",
        "gold"
      ],
      "additionalProperties": false,
      "properties": {
        "xp": {
          "type": "integer",
          "minimum": 0
        },
        "gold": {
          "type": "integer",
          "minimum": 0
        },
        "item": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "an heirloom (src/sim/items.js HEIRLOOMS), paid into the bag"
        }
      }
    },
    "dialogue": {
      "type": "object",
      "required": [
        "file",
        "offer",
        "turnin"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "offer": {
          "type": "string"
        },
        "turnin": {
          "type": "string"
        }
      }
    },
    "turnin": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "who takes it in, if not its giver"
    },
    "after": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "description": "quests that must be done first"
    },
    "reveal": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "description": "hidden sites its hand-in reveals (sim/sites.js)"
    },
    "companion": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "a found companion's chain: offered only while he's with you (party or bench)"
    },
    "trial": {
      "enum": [
        "fighter",
        "rogue",
        "mage",
        "cleric",
        "shaman"
      ],
      "description": "a class trial: offered while someone of this class in the company is level 6+; done, it teaches the class its level-6 ability"
    }
  }
}
