{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Loading tips (world doc §7): a lore line (with its source) or a one-liner (without)",
  "type": "object",
  "required": ["tips"],
  "additionalProperties": false,
  "properties": {
    "tips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 140 },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
