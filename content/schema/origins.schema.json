{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Origins (GDD §6.1, world doc §11)",
  "type": "object",
  "required": ["origins"],
  "additionalProperties": false,
  "properties": {
    "origins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "faction", "background", "edge"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string" },
          "faction": { "type": "string" },
          "background": { "type": "string" },
          "edge": {
            "type": "object",
            "required": ["kind", "text"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["tavernHirelings", "atk", "loreXp", "smithDiscount"] },
              "value": { "type": "number" },
              "text": { "type": "string" }
            }
          },
          "dialogue": { "type": "string" }
        }
      }
    }
  }
}
