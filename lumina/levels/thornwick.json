.8,"seed":0}},{"id":"haystack_3","type":"haystack","x":83.35,"z":64.7,"opts":{"size":0.8,"seed":8}},{"id":"rock_3","type":"rock","x":68.76,"z":5.87,"opts":{"size":1.15,"seed":30}},{"id":"rock_4","type":"rock","x":51.73,"z":14.53,"opts":{"size":1.01,"seed":46}},{"id":"rock_5","type":"rock","x":8.46,"z":17.74,"opts":{"size":1.01,"seed":2}},{"id":"rock_6","type":"rock","x":8.39,"z":32.85,"opts":{"size":1.01,"seed":22}},{"id":"rock_7","type":"rock","x":50.67,"z":52.72,"opts":{"size":1.06,"seed":56}},{"id":"rock_8","type":"rock","x":59.16,"z":58.01,"opts":{"size":1.01,"seed":71}},{"id":"rock_9","type":"rock","x":5.28,"z":69.33,"opts":{"size":1.06,"seed":35}},{"id":"rock_10","type":"rock","x":73.49,"z":69.78,"opts":{"size":1.15,"seed":72}},{"id":"rock_11","type":"rock","x":16.2,"z":71.15,"opts":{"size":1.06,"seed":2}},{"id":"maudry_fenn","type":"npc","x":25.75,"z":32.75,"name":"Maudry Fenn","title":"The Tired Mule","preset":"innkeeper","spec":{"emberActor":"npc_maudry"},"facing":"down","behaviour":"post","wander":0.6,"speed":0.8,"portraitColor":"#b8862e","action":"none","item":"","script":"","dialogue":["The woman at the Mule's door looks you over and goes on wiping a mug that was already clean.","\"Maudry Fenn. The Mule's mine. You'll be the one who came in off the road looking like the road came with you.\"","\"If you came by the crossroads you'll have seen them. The dead, standing across the barrows road in rows, facing north like they're waiting for somebody.\"","\"They don't come here. They don't need to. Nothing gets down that road, and everything I pour comes up it.\"","\"Still standing out there on the barrows road, the dead. Facing north. Nobody's told them nobody's coming.\""]},{"id":"osric_hale","type":"npc","x":40.75,"z":40.75,"name":"Osric Hale","title":"Warden-Captain","preset":"guard","spec":{"emberActor":"npc_osric"},"facing":"down","behaviour":"post","wander":0.6,"speed":0.8,"portraitColor":"#b8862e","action":"none","item":"","script":"","dialogue":["A grey man at a folding table by the well turns a page in a ledger and doesn't look up until he's finished the line.","\"Osric Hale. Warden-Captain, Greyholt's watch, which is to say Lord Pellam's, which is to say mostly mine.\"","\"Write your name in the book if you mean to stay. I like to know who to send the bill to.\"","Osric marks something in the ledger and nods at the stool. \"Sit if you like. It's the Watch's stool. Nobody else wants it.\""]},{"id":"sister_ilse","type":"npc","x":22.25,"z":25.25,"name":"Sister Ilse","title":"Grey Sister","preset":"cleric","spec":{"emberActor":"npc_ilse"},"facing":"down","behaviour":"post","wander":0.6,"speed":0.8,"portraitColor":"#b8862e","action":"none","item":"","script":"","dialogue":["A Grey Sister sits on the Shrine's step with a writing board on her knees, copying from a tablet so worn it is mostly guesswork. She frowns at the guesswork.","\"Sister Ilse. Reedholm sent me up to write down whatever comes out of the barrows before somebody burns it or sells it.\"","\"You'll be going down there. Everyone is, now.\"","Ilse looks up from the board and holds up a finger until she finishes the word."]},{"id":"wendel","type":"npc","x":32.25,"z":33.25,"name":"Wendel","title":"Provisions","preset":"merchant","spec":{"emberActor":"npc_wendel"},"facing":"down","behaviour":"post","wander":0.6,"speed":0.8,"portraitColor":"#b8862e","action":"none","item":"","script":"","dialogue":["\"Wendel. The provisions are mine. The prices are the roads' fault.\"","\"Lamp oil's up a copper. Before you ask, it's the roads.\""]},{"id":"bess_hale","type":"npc","x":35.25,"z":42.75,"name":"Bess Hale","title":"Hale & Daughter","preset":"villager","spec":{"emberActor":"npc_bess"},"facing":"down","behaviour":"post","wander":0.6,"speed":0.8,"portraitColor":"#b8862e","action":"none","item":"","script":"","dialogue":["\"Bess Hale. It's my name over the door, and my father's, and it's my arm doing the work. No, I'm not the Captain's. He says it first, usually.\"","\"The forge is open. Bring me what you wear and I'll make it better. Bring me what you won't, and I'll make it cinders.\""]},{"id":"col","type":"npc","x":41.75,"z":44.75,"name":"Col","title":"The Greyholt cart","preset":"villager","spec":{"emberActor":"npc_col"},"facing":"down","behaviour":"post","wander":0.6,"speed":0.8,"portraitColor":"#b8862e","action":"none","item":"","script":"","dialogue":["\"Col. I drive the Greyholt cart. Drove it the long way round the barrows a whole month, a day out each way. Just so you know.\"","\"The horse still shies at the mounds. So do I. Neither of us will say so.\""]},{"id":"jory","type":"npc","x":37.25,"z":47.75,"name":"Jory","title":"The Watch","preset":"guard","spec":{"emberActor":"npc_jory"},"facing":"down","behaviour":"post","wander":0.6,"speed":0.8,"portraitColor":"#b8862e","action":"none","item":"","script":"","dialogue":["\"Jory. The Watch. Well, the rest of the Watch. The Captain's the Watch; I'm the running about.\"","\"The Captain paid me this week. Out of his own purse. Don't tell him I told you. He writes it down anyway.\""]},{"id":"nell_tolley","type":"npc","x":35.25,"z":48.75,"name":"Nell Tolley","title":"The Crossed Keys","preset":"innkeeper","spec":{"emberActor":"npc_nell"},"facing":"down","behaviour":"post","wander":0.6,"speed":0.8,"portraitColor":"#b8862e","action":"none","item":"","script":"","dialogue":["\"Nell Tolley. The Crossed Keys. A bed's cheap. The stairs up to it are what you pay for.\"","\"Water's for the guests. The well's for everyone, and everyone's at it at dawn.\""]},{"id":"hedda","type":"npc","x":45.75,"z":44.25,"name":"Hedda","title":"Eggs","preset":"farmer","spec":{"emberActor":"npc_hedda"},"facing":"down","behaviour":"post","wander":0.6,"speed":0.8,"portraitColor":"#b8862e","action":"none","item":"","script":"","dialogue":["\"Hedda. Eggs, if you want them. I know the weather, too, but I don't sell that.\"","\"Fog off the fields this morning. It'll burn off by noon, same as yesterday. Eggs?\""]},{"id":"region_1","type":"region","minX":0,"maxX":90,"minZ":0,"maxZ":72,"name":"Thornwick","sub":"The Hollow Vale","minY":-10,"banner":"Emberfall's town, in Luminati's light"},{"id":"region_2","type":"region","minX":24,"maxX":48,"minZ":28,"maxZ":50,"name":"The Square","sub":"Thornwick","minY":-10,"banner":""},{"id":"region_3","type":"region","minX":19.59,"maxX":25.25,"minZ":16.52,"maxZ":25.92,"name":"Shrine of the Ember","sub":"Thornwick","minY":-10,"banner":""},{"id":"region_4","type":"region","minX":16.27,"maxX":24.13,"minZ":28.65,"maxZ":37.16,"name":"The Tired Mule","sub":"Thornwick","minY":-10,"banner":""},{"id":"region_5","type":"region","minX":29,"maxX":33.86,"minZ":26.5,"maxZ":33.04,"name":"Wendel's Provisions","sub":"Thornwick","minY":-10,"banner":""},{"id":"region_6","type":"region","minX":29.36,"maxX":33.91,"minZ":38.82,"maxZ":46.1,"name":"Hale & Daughter, Smiths","sub":"Thornwick","minY":-10,"banner":""},{"id":"region_7","type":"region","minX":38.96,"maxX":47.75,"minZ":33.3,"maxZ":40.05,"name":"The Crossed Keys","sub":"Thornwick","minY":-10,"banner":""},{"id":"emitter_1","type":"emitter","x":76,"z":43,"preset":"fireflies","size":[10,2,10],"count":22,"dy":0.9}]}